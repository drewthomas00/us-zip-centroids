  "files": [
    "index.js",
    "index.d.ts",
    "zip-centroids.js",
    "data/zip_centroids.csv",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "zip",
    "zipcode",
    "postal-code",
    "geocoding",
    "offline",
    "latitude",
    "longitude",
    "centroid",
    "census",
    "zcta",
    "haversine"
  ],
